DATABASE_URL=mysql+pymysql://visual_office:change-me@127.0.0.1:3306/visual_office_ai?charset=utf8mb4
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Provider untuk generasi teks agent: gemini atau openrouter.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# Model khusus untuk langkah Designer; agent lain tetap memakai OPENROUTER_MODEL.
OPENROUTER_DESIGNER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_REASONING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# File hasil agent hanya dapat ditulis ke folder ini.
WORKSPACE_ROOT=../workspace
